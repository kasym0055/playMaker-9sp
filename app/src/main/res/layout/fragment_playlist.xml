<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playlistRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/playlist_details_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/playlistContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="264dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/playlistCoverArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/playlist_details_cover_background">

                <ImageView
                    android:id="@+id/playlistCover"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="40dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/audio_player_placeholder"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/playlistTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/ys_display_medium"
                android:textColor="@color/playlist_details_header_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/playlistDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="@color/playlist_details_header_text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/playlistMetadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="@color/playlist_details_header_text"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/playlistShareButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/playlist_details_share"
                    android:padding="8dp"
                    android:src="@drawable/share_icon"
                    app:tint="@color/playlist_details_header_text" />

                <ImageButton
                    android:id="@+id/playlistMenuButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/playlist_details_menu"
                    android:padding="8dp"
                    android:src="@drawable/playlist_details_more" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/playlistBackButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/playlist_details_back"
        android:padding="12dp"
        android:src="@drawable/ic_back_arrow2"
        app:tint="@color/playlist_details_header_text" />

    <LinearLayout
        android:id="@+id/playlistTracksSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/playlist_details_sheet_background"
        android:clickable="true"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="264dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/playlist_details_sheet_handle" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlistTracksList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/playlistEmptyTracks"
                style="@style/MediaPlaceholderText"
                android:layout_width="match_parent"
                android:layout_gravity="top"
                android:layout_marginTop="24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/playlist_details_empty_tracks" />

        </FrameLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/playlistProgress"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/playlistError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/MediaPlaceholderText"
            android:text="@string/playlist_details_error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playlistRetryButton"
            style="@style/MediaActionButton"
            android:layout_marginTop="16dp"
            android:text="@string/playlist_details_retry" />

    </LinearLayout>

    <View
        android:id="@+id/playlistMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/playlist_details_overlay"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/playlistMenuSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/playlist_details_sheet_background"
        android:minHeight="383dp"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:behavior_skipCollapsed="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/playlist_details_sheet_handle" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playlistMenuSummary"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:layout_marginTop="12dp"
            android:paddingStart="13dp"
            android:paddingEnd="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/playlistMenuCover"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/PlayerPlaylistCoverShape"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/playlistMenuName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/ys_display_regular"
                android:maxLines="1"
                android:textColor="@color/yp_color_text"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/playlistMenuTrackCount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/playlistMenuCover"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/playlistMenuTrackCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="@color/author_name_color_music"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/playlistMenuName"
                app:layout_constraintTop_toBottomOf="@id/playlistMenuName" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/playlistMenuShare"
            style="@style/PlaylistDetailsMenuAction"
            android:layout_marginTop="8dp"
            android:text="@string/playlist_details_share" />

        <TextView
            android:id="@+id/playlistMenuEdit"
            style="@style/PlaylistDetailsMenuAction"
            android:text="@string/playlist_details_edit" />

        <TextView
            android:id="@+id/playlistMenuDelete"
            style="@style/PlaylistDetailsMenuAction"
            android:text="@string/playlist_details_delete" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
