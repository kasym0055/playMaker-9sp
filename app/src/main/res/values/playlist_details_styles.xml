<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PlaylistDetailsDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/yp_black</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:textColorPrimary">@color/yp_black</item>
        <item name="android:textColorSecondary">@color/yp_black</item>
        <item name="materialAlertDialogBodyTextStyle">@style/PlaylistDetailsDialogBody</item>
        <item name="materialAlertDialogTitleTextStyle">@style/PlaylistDetailsDialogTitle</item>
    </style>

    <style name="PlaylistDetailsDialogBody" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/yp_black</item>
    </style>

    <style name="PlaylistDetailsDialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/yp_black</item>
    </style>

    <style name="PlaylistDetailsMenuAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">61dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/yp_color_text</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
